# ============================================================
# CIVICCONNECT AI - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# FRONTEND (Vite / React)
# ------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe to use in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# FastAPI Backend URL (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# BACKEND (FastAPI / Python)
# ------------------------------------------------------------
# Supabase Project URL (same as frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Secret - DO NOT EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Groq Cloud API Key for AI Analysis & Simplification (Secret)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Backend Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
